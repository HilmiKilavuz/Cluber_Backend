# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
CORS_ORIGIN=http://localhost:3001

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=cluber
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=cluber_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cluber:your_password_here@localhost:5432/cluber_db?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT (will be configured in Auth module) ──────────────────────────────────
# JWT_SECRET=your-super-secret-key-change-in-production
# JWT_EXPIRATION=15m
# JWT_REFRESH_EXPIRATION=7d
